<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">
    <i class="bi bi-person-plus me-2"></i><%= title %>
  </h1>
  <a href="/tutores" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Voltar
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <form action="<%= action %>" method="<%= method %>">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Nome completo *</label>
          <input type="text" name="nome" class="form-control" required value="<%= tutor.nome || '' %>" placeholder="Ex: Ana Paula Ferreira">
        </div>
        <div class="col-md-6">
          <label class="form-label">Telefone *</label>
          <input type="text" name="telefone" class="form-control" required value="<%= tutor.telefone || '' %>" placeholder="(55) 99988-7766">
        </div>
        <div class="col-md-6">
          <label class="form-label">E-mail</label>
          <input type="email" name="email" class="form-control" value="<%= tutor.email || '' %>" placeholder="ana@email.com">
        </div>
        <div class="col-md-6">
          <label class="form-label">CPF *</label>
          <input type="text" name="cpf" class="form-control" required value="<%= tutor.cpf || '' %>" placeholder="000.000.000-00">
        </div>
        <div class="col-12">
          <label class="form-label">Endereço</label>
          <input type="text" name="endereco" class="form-control" value="<%= tutor.endereco || '' %>" placeholder="Rua, número - Bairro">
        </div>
        <div class="col-12">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" name="ativo" id="ativo"
              <%= (tutor.ativo === undefined || tutor.ativo === true) ? 'checked' : '' %>>
            <label class="form-check-label" for="ativo">Tutor ativo</label>
          </div>
        </div>
        <div class="col-12 mt-4">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i> Salvar
          </button>
          <a href="/tutores" class="btn btn-light ms-2">Cancelar</a>
        </div>
      </div>
    </form>
  </div>
</div>
