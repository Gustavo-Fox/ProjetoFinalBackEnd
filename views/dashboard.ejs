<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h1>
</div>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex align-items-center">
        <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
          <i class="bi bi-people fs-3 text-primary"></i>
        </div>
        <div>
          <div class="text-muted small">Tutores</div>
          <div class="fs-4 fw-bold"><%= totalTutores %></div>
        </div>
      </div>
      <div class="card-footer bg-transparent border-0 pt-0">
        <a href="/tutores" class="btn btn-sm btn-outline-primary w-100">Gerenciar</a>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex align-items-center">
        <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
          <i class="bi bi-emoji-smile fs-3 text-success"></i>
        </div>
        <div>
          <div class="text-muted small">Animais</div>
          <div class="fs-4 fw-bold"><%= totalAnimais %></div>
        </div>
      </div>
      <div class="card-footer bg-transparent border-0 pt-0">
        <a href="/animais" class="btn btn-sm btn-outline-success w-100">Gerenciar</a>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex align-items-center">
        <div class="bg-info bg-opacity-10 rounded-3 p-3 me-3">
          <i class="bi bi-calendar-check fs-3 text-info"></i>
        </div>
        <div>
          <div class="text-muted small">Atendimentos</div>
          <div class="fs-4 fw-bold"><%= totalAtendimentos %></div>
        </div>
      </div>
      <div class="card-footer bg-transparent border-0 pt-0">
        <a href="/atendimentos" class="btn btn-sm btn-outline-info w-100">Gerenciar</a>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body d-flex align-items-center">
        <div class="bg-warning bg-opacity-10 rounded-3 p-3 me-3">
          <i class="bi bi-clock-history fs-3 text-warning"></i>
        </div>
        <div>
          <div class="text-muted small">Agendados</div>
          <div class="fs-4 fw-bold"><%= atendimentosAgendados %></div>
        </div>
      </div>
      <div class="card-footer bg-transparent border-0 pt-0">
        <a href="/atendimentos?status=agendado" class="btn btn-sm btn-outline-warning w-100">Ver agendados</a>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white fw-semibold">
    <i class="bi bi-list-ul me-2"></i>Últimos Atendimentos
  </div>
  <div class="card-body p-0">
    <% if (ultimosAtendimentos && ultimosAtendimentos.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Animal</th>
              <th>Data/Hora</th>
              <th>Tipo</th>
              <th>Status</th>
              <th>Valor</th>
            </tr>
          </thead>
          <tbody>
            <% ultimosAtendimentos.forEach(a => { %>
              <tr>
                <td><%= a.animalNome %></td>
                <td><%= a.dataHora ? new Date(a.dataHora).toLocaleString('pt-BR') : '-' %></td>
                <td><%= a.tipo %></td>
                <td>
                  <% if (a.status === 'agendado') { %>
                    <span class="badge bg-primary">Agendado</span>
                  <% } else if (a.status === 'em_andamento') { %>
                    <span class="badge bg-warning text-dark">Em andamento</span>
                  <% } else if (a.status === 'concluido') { %>
                    <span class="badge bg-success">Concluído</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Cancelado</span>
                  <% } %>
                </td>
                <td>R$ <%= (a.valor || 0).toFixed(2).replace('.', ',') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-4 text-center text-muted">
        Nenhum atendimento cadastrado ainda.
      </div>
    <% } %>
  </div>
</div>
